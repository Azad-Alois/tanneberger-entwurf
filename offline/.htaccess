# OFFLINE-Modus: alle Aufrufe -> Hinweisseite mit 503 (vorübergehend). Zurück: ./hochladen.sh
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tanneberger-service.de%{REQUEST_URI} [L,R=302]
ErrorDocument 503 /wartung.html
RewriteCond %{REQUEST_URI} !^/wartung\.html$
RewriteRule ^ - [R=503,L]
<IfModule mod_headers.c>
  Header always set Retry-After "86400"
  Header always set X-Robots-Tag "noindex"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
</IfModule>
